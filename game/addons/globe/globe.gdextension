[configuration]
entry_symbol = "globe_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://addons/globe/bin/libglobe.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/globe/bin/libglobe.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/globe/bin/libglobe.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/globe/bin/libglobe.windows.template_release.x86_64.dll"
macos.debug = "res://addons/globe/bin/libglobe.macos.template_debug.framework"
macos.release = "res://addons/globe/bin/libglobe.macos.template_release.framework"
